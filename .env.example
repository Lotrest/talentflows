# Database
# Option 1: full DSN
# DATABASE_URL=postgresql+asyncpg://postgres:1234@127.0.0.1:5432/postgres
#
# Option 2: separate POSTGRES_* vars (DATABASE_URL will be built automatically)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Redis
REDIS_URL=redis://localhost:6379

# HH.ru OAuth
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret
HH_REDIRECT_URI=http://localhost:8000/api/v1/auth/hh/callback

# Superjob OAuth  (https://api.superjob.ru/)
SUPERJOB_CLIENT_ID=
SUPERJOB_CLIENT_SECRET=
SUPERJOB_REDIRECT_URI=http://localhost:8000/api/v1/auth/superjob/callback

# Работа.ру OAuth  (https://api.rabota.ru/)
RABOTA_RU_CLIENT_ID=
RABOTA_RU_CLIENT_SECRET=
RABOTA_RU_REDIRECT_URI=http://localhost:8000/api/v1/auth/rabota_ru/callback

# Авито OAuth  (https://developers.avito.ru/)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_REDIRECT_URI=http://localhost:8000/api/v1/auth/avito/callback

# LinkedIn OAuth  (https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Rate limits (requests per day per user)
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=200
RATE_LIMIT_TEAM=2000
